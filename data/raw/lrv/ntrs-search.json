090,"id":"265d040d4e0c478e95519a5b324b3708","type":"PROJECT"}],"title":"Mobility performance of the lunar roving vehicle:  Terrestrial studies:  Apollo 15 results","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-09-02T14:13:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19730008090,"meta":{"author":{"name":"Costes, N. C."},"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"id":"8a12d982b1d84d418573aa07a48f638f"},{"sequence":1,"submissionId":19730008090,"meta":{"author":{"name":"Farmer, J. E."},"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"id":"fd39d4fc4761415fa3a256bd0a58eca6"},{"sequence":2,"submissionId":19730008090,"meta":{"author":{"name":"George, E. B."},"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"id":"6dad629782dc4bea87543b73c98291a0"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19730008090,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"73N16817"},"created":"2013-09-02T14:13:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The constriants of the Apollo 15 mission dictated that the average and limiting performance capabilities of the first manned lunar roving vehicle be known or estimated within narrow margins. Extensive studies were conducted and are compared with the actual performance of the lunar roving vehicle during the Apollo 15 mission. From this comparison, conclusions are drawn relating to the capabilities and limitation of current terrestrial methodology in predicting the mobility performance of lunar roving vehicles under in-situ environmental conditions, and recommendations are offered concerning the performance of surface vehicles on future missions related to lunar or planetary exploration.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"Sweden","submissionId":19730008090,"endDate":"1972-04-28T00:00:00.0000000+00:00","name":"Intern. Conf. of the Intern. Soc. for Terrain-Vehicle Systems","location":"Stockholm and Kiruna","id":"83f0318f83b84046a5455a56430ab07d","startDate":"1972-04-24T00:00:00.0000000+00:00"}],"publications":[{"submissionId":19730008090,"id":"0aeb15a4b32a4c938bd2e053123c6c2a","publicationDate":"1972-12-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19730008090.pdf","type":"STI","links":{"original":"/api/citations/19730008090/downloads/19730008090.pdf","pdf":"/api/citations/19730008090/downloads/19730008090.pdf","fulltext":"/api/citations/19730008090/downloads/19730008090.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-01-04-12"},{"_meta":{"score":233.2174},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19740003321,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"9d21821a45564bd0a779e6530e61e791","belongsToAuthors":false},"subjectCategories":["Navigation"],"exportControl":{"isExportControl":"NO","submissionId":19740003321,"ear":"NO","id":"25fb56e38e054a76ad9a833ab90384f6","itar":"NO"},"distributionDate":"2019-06-19T00:00:00.0000000+00:00","otherReportNumbers":["NASA-TN-D-7469","M-219","Report Number: NASA-TN-D-7469","Report Number: M-219"],"title":"Lunar Roving Vehicle Navigation System Performance Review","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-09-03T11:59:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19740003321,"meta":{"author":{"name":"Smith, Earnest C."},"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"id":"ba5b07e625d44e229baa2ca3b14eb0d3"},{"sequence":1,"submissionId":19740003321,"meta":{"author":{"name":"Mastin, William C."},"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"id":"0aba2f62249c46a39a526b7602aabc40"}],"stiTypeDetails":"Other - NASA Technical Note (TN)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19740003321,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"74N11434"},"created":"2013-09-03T11:59:00.0000000+00:00","center":{"code":"MSFC","name":"Marshall Space Flight Center","id":"a589fc1e68af409f9d2214bb08863d11"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The design and operation of the lunar roving vehicle (LRV) navigation system are briefly described. The basis for the premission LRV navigation error analysis is explained and an example included. The real time mission support operations philosophy is presented. The LRV navigation system operation and accuracy during the lunar missions are evaluated.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":19740003321,"id":"4100521bff584226a2c140e190ed648c","publicationDate":"1973-11-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19740003321.pdf","type":"STI","links":{"original":"/api/citations/19740003321/downloads/19740003321.pdf","pdf":"/api/citations/19740003321/downloads/19740003321.pdf","fulltext":"/api/citations/19740003321/downloads/19740003321.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-01-04-12"},{"_meta":{"score":226.55746},"copyright":{"thirdPartyPermissionsProduced":false,"disclosed